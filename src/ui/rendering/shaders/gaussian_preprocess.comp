#version 450

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform CameraUniforms {
    mat4 viewMatrix;
    mat4 projectionMatrix;
    vec4 cameraPosition;
    vec4 viewportFocal;
    vec4 parameters;
    vec4 environmentFallback;
};

layout(std430, binding = 1) readonly buffer GaussianAttributes {
    float attributes[];
};

// Four vec4 values per Gaussian:
// clip-space center, pixel-space major/minor axes, color/opacity, extent/valid.
layout(std430, binding = 2) writeonly buffer ProjectedGaussians {
    vec4 projected[];
};

layout(std430, binding = 3) writeonly buffer DepthKeys {
    uint depthKeys[];
};

layout(std430, binding = 4) writeonly buffer GaussianIds {
    uint gaussianIds[];
};

const uint STRIDE = 59u;
const uint PROJECTED_STRIDE = 4u;
const float C0 = 0.28209479177387814;
const float C1 = 0.4886025119029199;

float coefficient(uint base, int channel, int coefficientIndex)
{
    if (coefficientIndex == 0)
        return attributes[base + 3u + uint(channel)];
    return attributes[base + 6u + uint(channel * 15 + coefficientIndex - 1)];
}

vec3 evaluateSphericalHarmonics(uint base, vec3 direction)
{
    float x = direction.x;
    float y = direction.y;
    float z = direction.z;
    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float basis[16];
    basis[0] = C0;
    basis[1] = -C1 * y;
    basis[2] = C1 * z;
    basis[3] = -C1 * x;
    basis[4] = 1.0925484305920792 * x * y;
    basis[5] = -1.0925484305920792 * y * z;
    basis[6] = 0.31539156525252005 * (2.0 * zz - xx - yy);
    basis[7] = -1.0925484305920792 * x * z;
    basis[8] = 0.5462742152960396 * (xx - yy);
    basis[9] = -0.5900435899266435 * y * (3.0 * xx - yy);
    basis[10] = 2.890611442640554 * x * y * z;
    basis[11] = -0.4570457994644658 * y * (4.0 * zz - xx - yy);
    basis[12] = 0.3731763325901154 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy);
    basis[13] = -0.4570457994644658 * x * (4.0 * zz - xx - yy);
    basis[14] = 1.445305721320277 * z * (xx - yy);
    basis[15] = -0.5900435899266435 * x * (xx - 3.0 * yy);
    vec3 color = vec3(0.0);
    for (int channel = 0; channel < 3; ++channel) {
        float value = 0.0;
        for (int index = 0; index < 16; ++index)
            value += coefficient(base, channel, index) * basis[index];
        color[channel] = value + 0.5;
    }
    return max(color, vec3(0.0));
}

mat3 quaternionMatrix(float w, float x, float y, float z)
{
    float lengthSquared = max(w*w + x*x + y*y + z*z, 1e-12);
    float scale = 2.0 / lengthSquared;
    float xs = x * scale;
    float ys = y * scale;
    float zs = z * scale;
    float wx = w * xs;
    float wy = w * ys;
    float wz = w * zs;
    float xx = x * xs;
    float xy = x * ys;
    float xz = x * zs;
    float yy = y * ys;
    float yz = y * zs;
    float zz = z * zs;
    return mat3(
        1.0 - (yy + zz), xy + wz, xz - wy,
        xy - wz, 1.0 - (xx + zz), yz + wx,
        xz + wy, yz - wx, 1.0 - (xx + yy));
}

vec3 depthHeat(float depth, float farDepth)
{
    float denominator = max(log2(1.0 + farDepth), 1e-4);
    float value = clamp(log2(1.0 + depth) / denominator, 0.0, 1.0);
    const vec3 nearColor = vec3(0.96, 0.20, 0.10);
    const vec3 nearMidColor = vec3(1.00, 0.84, 0.12);
    const vec3 middleColor = vec3(0.20, 0.78, 0.46);
    const vec3 farMidColor = vec3(0.08, 0.68, 0.88);
    const vec3 farColor = vec3(0.20, 0.16, 0.62);
    if (value < 0.25)
        return mix(nearColor, nearMidColor, value * 4.0);
    if (value < 0.5)
        return mix(nearMidColor, middleColor, (value - 0.25) * 4.0);
    if (value < 0.75)
        return mix(middleColor, farMidColor, (value - 0.5) * 4.0);
    return mix(farMidColor, farColor, (value - 0.75) * 4.0);
}

void rejectGaussian(uint index, uint outputBase)
{
    projected[outputBase] = vec4(2.0, 2.0, 2.0, 1.0);
    projected[outputBase + 1u] = vec4(0.0);
    projected[outputBase + 2u] = vec4(0.0);
    projected[outputBase + 3u] = vec4(0.0);
    depthKeys[index] = 0xffffffffu;
    gaussianIds[index] = index;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint count = uint(parameters.z + 0.5);
    if (index >= count)
        return;
    uint base = index * STRIDE;
    uint outputBase = index * PROJECTED_STRIDE;
    vec3 mean = vec3(attributes[base], attributes[base + 1u], attributes[base + 2u]);
    vec3 cameraOffset = mean - cameraPosition.xyz;
    vec4 cameraMean4 = viewMatrix * vec4(mean, 1.0);
    vec3 cameraMean = cameraMean4.xyz;
    float depth = -cameraMean.z;
    if (!(depth > parameters.y) || isnan(depth) || isinf(depth)) {
        rejectGaussian(index, outputBase);
        return;
    }

    vec3 scales = exp(vec3(attributes[base + 52u],
                           attributes[base + 53u],
                           attributes[base + 54u]));
    mat3 rotation = quaternionMatrix(attributes[base + 55u],
                                     attributes[base + 56u],
                                     attributes[base + 57u],
                                     attributes[base + 58u]);
    mat3 scaledRotation = rotation * mat3(scales.x, 0.0, 0.0,
                                          0.0, scales.y, 0.0,
                                          0.0, 0.0, scales.z);
    mat3 worldCovariance = scaledRotation * transpose(scaledRotation);
    mat3 viewRotation = mat3(viewMatrix);
    mat3 cameraCovariance = viewRotation * worldCovariance * transpose(viewRotation);
    float fx = viewportFocal.z;
    float fy = viewportFocal.w;
    float inverseDepth = 1.0 / depth;
    float inverseDepthSquared = inverseDepth * inverseDepth;
    float tanHalfFovX = 0.5 * viewportFocal.x / fx;
    float tanHalfFovY = 0.5 * viewportFocal.y / fy;
    float projectedX = depth * clamp(cameraMean.x * inverseDepth,
                                     -1.3 * tanHalfFovX,
                                     1.3 * tanHalfFovX);
    float projectedY = depth * clamp(cameraMean.y * inverseDepth,
                                     -1.3 * tanHalfFovY,
                                     1.3 * tanHalfFovY);
    vec3 jacobianX = vec3(fx * inverseDepth,
                          0.0,
                          fx * projectedX * inverseDepthSquared);
    vec3 jacobianY = vec3(0.0,
                          fy * inverseDepth,
                          fy * projectedY * inverseDepthSquared);
    float covXX = dot(jacobianX, cameraCovariance * jacobianX);
    float covXY = dot(jacobianX, cameraCovariance * jacobianY);
    float covYY = dot(jacobianY, cameraCovariance * jacobianY);
    float determinantBefore = max(covXX * covYY - covXY * covXY, 0.0);
    covXX += parameters.x;
    covYY += parameters.x;
    float determinantAfter = max(covXX * covYY - covXY * covXY, 1e-8);
    float antialiasCompensation = sqrt(determinantBefore / determinantAfter);
    float compensatedOpacity = clamp((1.0 / (1.0 + exp(-attributes[base + 51u])))
                                         * antialiasCompensation,
                                     0.0,
                                     0.999);
    const float alphaThreshold = 1.0 / 255.0;
    if (!(compensatedOpacity >= alphaThreshold)) {
        rejectGaussian(index, outputBase);
        return;
    }
    float extent = min(3.33,
                       sqrt(max(2.0 * log(compensatedOpacity / alphaThreshold), 0.0)));
    float midpoint = 0.5 * (covXX + covYY);
    float radius = sqrt(max(0.25 * (covXX - covYY) * (covXX - covYY)
                            + covXY * covXY,
                            1e-8));
    float lambdaMajor = max(midpoint + radius, 0.1);
    float lambdaMinor = max(midpoint - radius, 0.1);
    float angle = 0.5 * atan(2.0 * covXY, covXX - covYY);
    vec2 majorDirection = vec2(cos(angle), sin(angle));
    vec2 minorDirection = vec2(-majorDirection.y, majorDirection.x);
    vec2 majorAxis = majorDirection * (extent * sqrt(lambdaMajor));
    vec2 minorAxis = minorDirection * (extent * sqrt(lambdaMinor));
    vec4 clipMean = projectionMatrix * cameraMean4;
    vec2 ndc = clipMean.xy / clipMean.w;
    vec2 ndcRadius = 2.0 * (abs(majorAxis) + abs(minorAxis)) / viewportFocal.xy;
    bool outside = ndc.x + ndcRadius.x < -1.0 || ndc.x - ndcRadius.x > 1.0
                   || ndc.y + ndcRadius.y < -1.0 || ndc.y - ndcRadius.y > 1.0;
    if (outside || any(isnan(ndcRadius)) || any(isinf(ndcRadius))) {
        rejectGaussian(index, outputBase);
        return;
    }

    int visualizationMode = int(parameters.w + 0.5);
    vec3 visualizationColor;
    if (visualizationMode == 1) {
        // Relative camera-space depth. cameraPosition.w stores a robust scene
        // range; this is not metres unless an external scale anchor exists.
        visualizationColor = depthHeat(depth, cameraPosition.w);
    } else if (visualizationMode == 2) {
        // A Gaussian's shortest local axis is a structure cue, not a certified
        // surface normal. Nearly isotropic splats intentionally fade to gray.
        int normalAxis = 0;
        if (scales.y < scales.x && scales.y <= scales.z)
            normalAxis = 1;
        else if (scales.z < scales.x && scales.z < scales.y)
            normalAxis = 2;
        float minimumScale = min(scales.x, min(scales.y, scales.z));
        float maximumScale = max(scales.x, max(scales.y, scales.z));
        float surfaceEvidence = clamp(1.0 - minimumScale / max(maximumScale, 1e-8),
                                      0.0,
                                      1.0);
        vec3 cameraNormal = normalize(viewRotation * rotation[normalAxis]);
        visualizationColor = mix(vec3(0.32),
                                 0.12 + 0.88 * abs(cameraNormal),
                                 surfaceEvidence);
    } else if (visualizationMode == 3) {
        // Premultiplied white splats on black visualize accumulated opacity.
        // Black exposes weakly observed or unsupported regions.
        visualizationColor = vec3(1.0);
    } else {
        visualizationColor = evaluateSphericalHarmonics(base, normalize(cameraOffset));
    }

    projected[outputBase] = clipMean;
    projected[outputBase + 1u] = vec4(majorAxis, minorAxis);
    projected[outputBase + 2u] = vec4(visualizationColor, compensatedOpacity);
    projected[outputBase + 3u] = vec4(extent, 1.0, 0.0, 0.0);
    // Match the gsplat 1.5.3 producing rasterizer: positive camera-space Z is
    // unsigned-monotonic, and inversion makes ascending radix order far-to-near
    // for premultiplied back-to-front blending.  A future matched-training
    // hierarchical rasterizer can refine this order per tile and pixel.
    depthKeys[index] = ~floatBitsToUint(depth);
    gaussianIds[index] = index;
}
