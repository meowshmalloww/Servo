# Vertex AI Express / Google Cloud authorization key. Never commit the real value.
GOOGLE_API_KEY=replace-with-your-google-cloud-api-key
SERVO_GOOGLE_API=vertex


# For a Gemini Developer API key instead, use:
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# SERVO_GOOGLE_API=developer

# Desktop/control-API authentication. Local development is the default only
# outside Cloud Run; set it explicitly in developer launch scripts.
SERVO_AUTH_MODE=local
# SERVO_API_TOKEN=replace-with-a-local-development-token

# Firebase Authentication for the deployed desktop/API boundary. The web API
# key identifies the Firebase project; it is not an admin credential.
# SERVO_AUTH_MODE=firebase
# SERVO_FIREBASE_API_KEY=replace-with-firebase-web-api-key
# SERVO_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# SERVO_FIREBASE_REQUIRED_CLAIM=servo_access
# SERVO_FIREBASE_REQUIRE_VERIFIED_EMAIL=1
# SERVO_API_URL=https://your-servo-api.run.app
