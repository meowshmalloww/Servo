# Vertex AI Express / Google Cloud authorization key. Never commit the real value.
GOOGLE_API_KEY=replace-with-your-google-cloud-api-key
SERVO_GOOGLE_API=vertex

# OpenAI Responses API. Never commit the real value.
OPENAI_API_KEY=replace-with-your-openai-project-api-key

# For a Gemini Developer API key instead, use:
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# SERVO_GOOGLE_API=developer
