# Names only. Never commit credentials or Firebase ID tokens.
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
FIREBASE_PROJECT_ID=your-project-id

API_SERVICE=servo-realityci-api
CAMPAIGN_JOB=servo-campaign-job
SERVO_GCS_BUCKET=your-project-id-servo-artifacts
SERVO_GCS_PREFIX=campaigns

# Local mode only. Cloud mode is fail-closed Firebase authentication.
SERVO_AUTH_MODE=local
SERVO_API_TOKEN=
SERVO_CAMPAIGN_ROOT=./campaigns

# Cloud Run/Vertex uses Application Default Credentials. The API-key path is
# retained only for a bounded local Gemini test.
SERVO_GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
